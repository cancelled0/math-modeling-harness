{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math Modeling Pipeline or Profile Template",
  "type": "object",
  "required": ["schema_version"],
  "oneOf": [
    {"required": ["defaults", "steps", "runtime_revision"]},
    {"required": ["profile", "extends", "defaults"]}
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["lean", "submission"]},
    "extends": {"const": "pipeline.template.json"},
    "exclude_steps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "step_overrides": {"type": "object"},
    "runtime_revision": {"type": "integer", "minimum": 1},
    "defaults": {
      "type": "object",
      "properties": {
        "paper_format": {"enum": ["latex", "word", "markdown", "none"]},
        "delivery_mode": {"enum": ["single", "latex_primary_docx_mirror"]}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skill", "outputs", "checks", "gate_after"],
        "properties": {
          "id": {"type": "string"},
          "skill": {"type": "string"},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "checks": {"type": "array", "items": {"type": "string"}},
          "gate_after": {"type": "string"},
          "paper_formats": {"type": "array", "items": {"type": "string"}},
          "delivery_modes": {"type": "array", "items": {"type": "string"}},
          "delivery_artifact": {"type": "boolean"},
          "external_capabilities": {"type": "array", "items": {"type": "string"}},
          "checkpoint": {
            "type": "object",
            "required": ["reason", "policy", "decision_type"],
            "properties": {"policy": {"const": "never_auto_approve"}}
          }
        }
      }
    }
  }
}
