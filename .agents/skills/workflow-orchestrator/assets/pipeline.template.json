{
  "schema_version": 1,
  "defaults": {
    "contest_profile": "CUMCM",
    "implementation_language": "auto",
    "evidence_depth": "source_scan",
    "research_budget_minutes": 30,
    "feature_engineering": false,
    "detailed_code_plan": false,
    "question_dependencies": {}
  },
  "steps": [
    {
      "id": "problem-frame", "skill": "problem-framer",
      "outputs": ["planning/problem_contract.json"], "artifact_key": "problem_contract",
      "checks": ["artifact_check"], "gate_after": "G0", "scope": "global"
    },
    {
      "id": "framing-check", "skill": "workflow-orchestrator",
      "outputs": ["planning/problem_contract.json"], "checks": ["artifact_check", "human_decision_check"],
      "gate_after": "G0", "scope": "global",
      "checkpoint": {
        "reason": "material_framing_ambiguity", "policy": "never_auto_approve",
        "decision_type": "framing_choice", "decision_file": "planning/framing_decisions.jsonl",
        "choices": ["accept"], "conditional_field": "material_ambiguities"
      }
    },
    {
      "id": "data-audit", "skill": "data-auditor-cleaner",
      "outputs": ["workspace/data/data_profile.json", "workspace/data/source_registry.json"],
      "artifact_key": "data_profile", "checks": ["artifact_check", "data_ingest_check"],
      "gate_after": "G1", "scope": "global"
    },
    {
      "id": "academic-evidence-scan", "skill": "modeling-evidence-collector",
      "outputs": ["workspace/evidence/{question}/evidence_brief.json"], "artifact_key": "evidence_brief",
      "checks": ["artifact_check", "evidence_check"], "gate_after": "G1"
    },
    {
      "id": "feature-engineering", "skill": "feature-engineering",
      "outputs": ["workspace/features/{question}/{question_lower}_feature_spec.json", "workspace/features/{question}/{question_lower}_feature_audit.json"],
      "checks": ["artifact_check"], "gate_after": "G1", "optional_config": "feature_engineering"
    },
    {
      "id": "method-screen", "skill": "method-selector",
      "outputs": ["methods/{question}/{question_lower}_method_card.md", "methods/{question}/probes/risk_probe_summary.json", "methods/{question}/method_contract.json"],
      "artifact_key": "method_contract", "checks": ["artifact_check"], "gate_after": "G2"
    },
    {
      "id": "method-choice", "skill": "workflow-orchestrator",
      "outputs": ["methods/{question}/{question_lower}_decisions.jsonl"], "artifact_key": "decision_ledger",
      "checks": ["human_decision_check"], "gate_after": "G2.5",
      "checkpoint": {"reason": "final_method_choice", "policy": "never_auto_approve", "decision_type": "method_choice", "choices": ["accept"]}
    },
    {
      "id": "git-experiment", "skill": "git-experiment-manager",
      "outputs": ["planning/experiments/{question}/active_experiment.json"], "artifact_key": "experiment_context",
      "checks": ["git_context_check"], "gate_after": "G2.5"
    },
    {
      "id": "model-foundations", "skill": "model-assumptions-builder",
      "outputs": ["methods/{question}/{question_lower}_foundations.json"],
      "checks": ["artifact_check"], "gate_after": "G2.5"
    },
    {
      "id": "implementation-spec", "skill": "model-code-analyzer",
      "outputs": ["code/{question}/{question_lower}_implementation_spec.json"], "artifact_key": "implementation_spec",
      "checks": ["artifact_check"], "gate_after": "G2.5", "optional_config": "detailed_code_plan",
      "language_variants": {"matlab": {"outputs": ["code/matlab/{question}/{question_lower}_implementation_spec.json"]}},
      "inputs": ["methods/{question}/method_contract.json", "methods/{question}/{question_lower}_foundations.json", "workspace/data/data_profile.json"]
    },
    {
      "id": "model-run", "skill": "python-model-code-generator",
      "outputs": ["results/{question}/experiments/{experiment_id}/run_summary.json"], "artifact_key": "latest_run",
      "checks": ["artifact_check", "method_reference_check", "scientific_check"], "gate_after": "G2.5",
      "language_variants": {"matlab": {"skill": "matlab-model-code-generator"}},
      "inputs": ["methods/{question}/method_contract.json", "methods/{question}/{question_lower}_foundations.json", "workspace/data/data_profile.json"]
    },
    {
      "id": "code-review", "skill": "python-code-reviewer",
      "outputs": ["code/{question}/reviews/{question_lower}_python_review.json"], "artifact_key": "code_review",
      "checks": ["artifact_check", "leakage_check"], "gate_after": "G3",
      "language_variants": {"matlab": {"skill": "matlab-code-reviewer", "outputs": ["code/matlab/{question}/reviews/{question_lower}_matlab_review.json"]}}
    },
    {
      "id": "run-assessment", "skill": "result-evaluator",
      "outputs": ["results/{question}/reports/{question_lower}_run_assessment.json"], "artifact_key": "run_assessment",
      "checks": ["artifact_check"], "gate_after": "G3"
    },
    {
      "id": "robustness", "skill": "robustness-checker",
      "outputs": ["robustness/{question}/{question_lower}_robustness_summary.json"], "artifact_key": "robustness_summary",
      "checks": ["artifact_check"], "gate_after": "G3", "optional_config": "robustness_required",
      "inputs": ["results/{question}/experiments/{experiment_id}/run_summary.json", "results/{question}/reports/{question_lower}_run_assessment.json"]
    },
    {
      "id": "result-synthesis", "skill": "result-evaluator",
      "outputs": ["results/{question}/reports/{question_lower}_result_evidence.json"], "artifact_key": "result_evidence",
      "checks": ["artifact_check", "method_reference_check"], "gate_after": "G4",
      "inputs": ["results/{question}/experiments/{experiment_id}/run_summary.json", "results/{question}/reports/{question_lower}_run_assessment.json"]
    },
    {
      "id": "result-verdict", "skill": "workflow-orchestrator",
      "outputs": ["methods/{question}/{question_lower}_decisions.jsonl"], "artifact_key": "decision_ledger",
      "checks": ["human_decision_check"], "gate_after": "G4", "optional_config": "require_result_verdict",
      "checkpoint": {
        "reason": "result_accept_adjust_or_fallback", "policy": "never_auto_approve",
        "decision_type": "result_verdict", "choices": ["accept", "reject", "adjust", "fallback"]
      }
    },
    {
      "id": "solution-presentation", "skill": "modeling-results-presenter",
      "outputs": ["results/{question}/reports/{question_lower}_solution_presentation.json", "results/{question}/reports/{question_lower}_solution_presentation.md"],
      "artifact_key": "solution_presentation", "checks": ["artifact_check", "solution_presentation_check"], "gate_after": "G4",
      "inputs": ["methods/{question}/method_contract.json", "methods/{question}/{question_lower}_foundations.json", "results/{question}/reports/{question_lower}_run_assessment.json", "results/{question}/reports/{question_lower}_result_evidence.json"]
    }
  ],
  "runtime_revision": 3
}
